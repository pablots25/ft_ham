    "what_new_bugfix1" : {
      "comment" : "First bug fix - Auto TX and Logging issue.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto TX & Logging: Fixed interleaved QSO entries that were incorrectly marked as invalid when report exchanges weren't sequential."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto TX y Registro: Se corrigieron las entradas de QSO intercaladas que se marcaban incorrectamente como inválidas cuando los intercambios de reportes no eran secuenciales."
          }
        }
      }
    },
    "what_new_bugfix2" : {
      "comment" : "Second bug fix - Callsign Switching Logic.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callsign Switching: Fixed issue where the app could continue transmitting to the previous station instead of switching to the new target callsign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio de indicativo: Se corrigió el problema donde la app podría continuar transmitiendo a la estación anterior en lugar de cambiar al nuevo indicativo objetivo."
          }
        }
      }
    },
    "what_new_bugfix3" : {
      "comment" : "Third bug fix - General bugfixes.",
      "extractionState" : "manual",
