    "Without this you can still enter your grid locator manually in Configuration." : {
      "comment" : "Impact text for location permission step, explaining that they can still enter their grid locator manually if location access is not granted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
