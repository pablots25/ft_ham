    "what_new_bugfix1" : {
      "comment" : "First bug fix - Auto TX and Logging issue.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-TX und Logging: Verschachtelte QSO-Einträge, die bei nicht sequentiellen Rapport-Austauschen fälschlich als ungültig markiert wurden, sind behoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto TX & Logging: Fixed interleaved QSO entries that were incorrectly marked as invalid when report exchanges weren't sequential."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto TX y Registro: Se corrigieron las entradas de QSO intercaladas que se marcaban incorrectamente como inválidas cuando los intercambios de reportes no eran secuenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TX auto et journal : correction des QSO entrelacés marqués à tort comme invalides lorsque les échanges de reports n'étaient pas séquentiels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TX automatico e log: corretti i QSO intercalati erroneamente contrassegnati come non validi quando gli scambi di rapporti non erano sequenziali."
          }
        }
      }
    },
    "what_new_bugfix2" : {
      "comment" : "Second bug fix - Callsign Switching Logic.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rufzeichenwechsel: Fehler behoben, bei dem die App weiter zur vorherigen Station sendete, statt zum neuen Ziel-Rufzeichen zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callsign Switching: Fixed issue where the app could continue transmitting to the previous station instead of switching to the new target callsign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio de indicativo: Se corrigió el problema donde la app podría continuar transmitiendo a la estación anterior en lugar de cambiar al nuevo indicativo objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changement d'indicatif : correction d'un problème où l'app pouvait continuer à transmettre vers la station précédente au lieu de passer au nouvel indicatif cible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio di nominativo: risolto un problema per cui l'app poteva continuare a trasmettere alla stazione precedente invece di passare al nuovo nominativo."
          }
        }
      }
    },
